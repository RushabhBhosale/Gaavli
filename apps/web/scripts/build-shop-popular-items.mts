// Picks the "popular items" chips a shop can tick under each product group,
// from the generated catalogue. Writes packages/constants/src/shopPopularItems.ts.
//
//   npm run build:shop-items --workspace=@gaavli/web            # print counts
//   npm run build:shop-items --workspace=@gaavli/web -- --write # write file
//
// Per group: the first LEAD products of the group's first subcategory (the
// everyday items), then one product at a time from each subcategory in turn,
// so a group such as household shows soap, utensils and bulbs, not ten kinds
// of detergent. Varieties (`variantOf`) and inactive products are skipped.
import { readFileSync, writeFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const PER_GROUP = 18;
const LEAD = 6;
const here = dirname(fileURLToPath(import.meta.url));
const data = resolve(here, "../data/catalog");
const target = resolve(
  here,
  "../../../packages/constants/src/shopPopularItems.ts",
);

type Names = { en: string; hi: string; mr: string };
type Catalog = {
  categories: {
    categoryId: string;
    subcategories: { subcategoryId: string }[];
  }[];
  products: {
    productCode: string;
    categoryId: string;
    subcategoryId: string;
    names: Names;
    variantOf: string | null;
    status: string;
    sortOrder: number;
  }[];
};
type MasterRow = { code: string; productGroup: string; status: string };

const catalog = JSON.parse(
  readFileSync(resolve(data, "catalog.v1.json"), "utf8"),
) as Catalog;
const masters = new Map(
  (
    JSON.parse(
      readFileSync(resolve(data, "product-master.v2.json"), "utf8"),
    ) as MasterRow[]
  ).map((row) => [row.code, row]),
);
const subRank = new Map<string, number>();
for (const category of catalog.categories)
  for (const sub of category.subcategories)
    subRank.set(`${category.categoryId}/${sub.subcategoryId}`, subRank.size);

const bySub = new Map<string, Map<string, Catalog["products"]>>();
for (const product of catalog.products) {
  const master = masters.get(product.productCode);
  if (product.variantOf || product.status !== "active") continue;
  if (!master || master.status !== "ACTIVE") continue;
  const subs = bySub.get(master.productGroup) ?? new Map();
  const key = `${product.categoryId}/${product.subcategoryId}`;
  subs.set(key, [...(subs.get(key) ?? []), product]);
  bySub.set(master.productGroup, subs);
}

const out: Record<string, { code: string } & Names[]> = {};
for (const [group, subs] of [...bySub].sort((a, b) =>
  a[0].localeCompare(b[0]),
)) {
  const queues = [...subs]
    .sort((a, b) => subRank.get(a[0])! - subRank.get(b[0])!)
    .map(([, rows]) => [...rows].sort((a, b) => a.sortOrder - b.sortOrder));
  const picked = queues[0].splice(0, LEAD);
  while (picked.length < PER_GROUP && queues.some((queue) => queue.length))
    for (const queue of queues)
      if (queue.length && picked.length < PER_GROUP)
        picked.push(queue.shift()!);
  out[group] = picked.map((p) => ({
    code: p.productCode,
    en: p.names.en,
    mr: p.names.mr,
    hi: p.names.hi,
  })) as never;
}

for (const [group, rows] of Object.entries(out))
  console.log(
    `${group}: ${(rows as unknown as Names[]).map((r) => r.en).join(", ")}`,
  );

if (process.argv.includes("--write")) {
  const body = Object.entries(out)
    .map(
      ([group, rows]) =>
        `  ${group}: [\n${(rows as unknown as ({ code: string } & Names)[])
          .map(
            (r) =>
              `    { code: ${JSON.stringify(r.code)}, en: ${JSON.stringify(r.en)}, mr: ${JSON.stringify(r.mr)}, hi: ${JSON.stringify(r.hi)} },`,
          )
          .join("\n")}\n  ],`,
    )
    .join("\n");
  writeFileSync(
    target,
    `// Generated by apps/web/scripts/build-shop-popular-items.mts. Do not edit by hand.\n` +
      `// The chips a shop can tick under each product group ("popular items").\n` +
      `export type ShopPopularItem = { code: string; en: string; mr: string; hi: string };\n` +
      `export const SHOP_POPULAR_ITEMS: Readonly<Record<string, readonly ShopPopularItem[]>> = {\n${body}\n};\n`,
  );
  console.log(`Wrote ${target}`);
}
