#   MONGODB_URI=mongodb://127.0.0.1:27017/gaavli?replicaSet=rs0
  JWT_SECRET=replace-with-a-random-secret
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/gaavli
ADMIN_EMAIL=admin@gaavli.com
ADMIN_PASSWORD=password@123
ADMIN_NAME=Admin

# Mobile local development only. Test provider is rejected in production.
# Temporary hosted testing: test OTP also works in production; no SMS is sent.
OTP_PROVIDER=test
OTP_TEST_CODE=123456
MOBILE_AUTH_SECRET=
# Enable only behind a trusted proxy which overwrites x-forwarded-for.
MOBILE_TRUST_PROXY=false

# New product uploads use GridFS through MONGODB_URI in all environments.
# Optional HTTPS public R2/S3/CDN base for legacy listing image objects.
LISTING_PHOTO_BASE_URL=

# Legacy local photos only: read compatibility and migrate:listing-photos source.
# No new product uploads write here. Default: .local/listing-photos in apps/web.
LISTING_PHOTO_UPLOAD_DIR=
