MONGODB_URI=mongodb://127.0.0.1:27017/gaavli?replicaSet=rs0
JWT_SECRET=
ADMIN_EMAIL=admin@gaavli.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Mobile local development only. Test provider is rejected in production.
OTP_PROVIDER=test
OTP_TEST_CODE=123456
MOBILE_AUTH_SECRET=
# Enable only behind a trusted proxy which overwrites x-forwarded-for.
MOBILE_TRUST_PROXY=false

# Optional public R2/S3/CDN base for approved listing image objects (HTTPS).
# Development without this uses backend /listing-photos/ static files.
LISTING_PHOTO_BASE_URL=

# Optional DEVELOPMENT-ONLY local upload directory; default .local/listing-photos
# relative to apps/web. Keep outside public/ and source control. Production requires
# a durable R2/S3 provider; the local upload endpoint fails closed in production.
LISTING_PHOTO_UPLOAD_DIR=
