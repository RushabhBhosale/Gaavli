{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=@gaavli/web"],
      "port": 3000
    },
    {
      "name": "mobile-ios-go",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1",
        "npm",
        "run",
        "start:go",
        "--workspace=@gaavli/mobile",
        "--",
        "--port",
        "8082",
        "--ios"
      ],
      "port": 8082
    }
  ]
}
